# OAuth credentials (from GCP Console)
GBP_CLIENT_ID=your_client_id
GBP_CLIENT_SECRET=your_client_secret

GMAIL_CLIENT_ID=your_gmail_client_id
GMAIL_CLIENT_SECRET=your_gmail_client_secret

# GCP Project
GCP_PROJECT_ID=oaky-gmb

# Google Sheets
SPREADSHEET_ID=your_spreadsheet_id
SHEET_NAME=レビュー一覧

# Pub/Sub
PUBSUB_TOPIC=gbp-review-notifications

# Secret Manager key names
SECRET_GBP_REFRESH_TOKEN=gbp-refresh-token
SECRET_GMAIL_REFRESH_TOKEN=gmail-refresh-token
